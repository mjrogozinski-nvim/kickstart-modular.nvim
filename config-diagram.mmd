flowchart TD
  INIT["<b>init.lua</b><br/>(entry point)"]
  OPT["lua/options.lua<br/>editor options"]
  LB["lua/lazy-bootstrap.lua<br/>clones + sets up lazy.nvim"]
  PROF["lua/enable-profile.lua<br/>reads NVIM_CONFIG_PROFILE (default: home)"]
  LSPL["lua/lsp-config.lua<br/>vim.lsp.enable: ast-grep, nixd"]

  subgraph SANE["code/sane/ — behavior fixes (13)"]
    direction LR
    S1["change · copy · wincmd · noh<br/>exit-terminal · autosave · q-closes-buffers<br/>dont-autocomment · visual-paste<br/>H/L jumps · visual-block · keepjumps<br/>stackjumplist"]
  end

  subgraph UTILS["code/ — custom mappings & helpers (~20)"]
    direction LR
    U1["highlight-on-yank · autoresize · spell-check<br/>open-reference-in-second-split · file-grep<br/>completion-jumping · copy-file-path · f2-gf"]
    U2["qflist open/close/nav · close-buffer · move-line<br/>make-session · multi-line-star · select-colorscheme<br/>edit-configuration · treesitter-actions"]
    U3["utils/: save-writable-buffer<br/>save-all-writable-buffers · buf-key-map"]
  end

  INIT --> OPT
  INIT --> LB
  INIT --> PROF
  INIT --> LSPL
  INIT --> SANE
  INIT --> UTILS
  INIT --> PAL["lua/code/' . Config_profile .. '.all'"]

